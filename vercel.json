{
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/site3",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/site3/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/site3/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:page(index|activites|activite|adhesion|contact|conditions-utilisation|evenement|formation|galerie|liens-utiles|mentions-legales|planning|sortie|sorties-voyages|statuts).html",
      "destination": "/:page",
      "permanent": true
    },
    {
      "source": "/:page(index|activites|activite|adhesion|contact|conditions-utilisation|evenement|formation|galerie|liens-utiles|mentions-legales|planning|sortie|sorties-voyages|statuts)/",
      "destination": "/:page",
      "permanent": true
    },
    {
      "source": "/site3/:page(index|activites|activite|adhesion|contact|conditions-utilisation|evenement|formation|galerie|liens-utiles|mentions-legales|planning|sortie|sorties-voyages|statuts).html",
      "destination": "/:page",
      "permanent": true
    },
    {
      "source": "/site3/:page(index|activites|activite|adhesion|contact|conditions-utilisation|evenement|formation|galerie|liens-utiles|mentions-legales|planning|sortie|sorties-voyages|statuts)/",
      "destination": "/:page",
      "permanent": true
    },
    {
      "source": "/connexion",
      "destination": "https://cbrs-cms.vercel.app/admin/",
      "permanent": true
    },
    {
      "source": "/connexion.html",
      "destination": "https://cbrs-cms.vercel.app/admin/",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "https://cbrs-cms.vercel.app/admin/",
      "permanent": true
    },
    {
      "source": "/admin.html",
      "destination": "https://cbrs-cms.vercel.app/admin/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/site3/index.html"
    },
    {
      "source": "/favicon.ico",
      "destination": "/site3/favicon.ico"
    },
    {
      "source": "/:page(index|activites|activite|adhesion|contact|conditions-utilisation|evenement|formation|galerie|liens-utiles|mentions-legales|planning|sortie|sorties-voyages|statuts)",
      "destination": "/site3/:page.html"
    },
    {
      "source": "/cms-docs/:file*",
      "destination": "https://cbrs-cms.vercel.app/api/documents/file/:file*"
    },
    {
      "source": "/:path((?!api).*)",
      "destination": "/site3/:path"
    }
  ]
}
