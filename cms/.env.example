# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
# SQLite en local (fichier créé au premier lancement) ou PostgreSQL en
# production : l'adaptateur est choisi selon le préfixe de l'URL
# (postgres:// ou postgresql:// → PostgreSQL, sinon SQLite).
DATABASE_URL=file:./cbrs-cms.db
# Alias fourni par l'intégration Neon de Vercel ; utilisé si DATABASE_URL est absent.
# POSTGRES_URL=postgresql://user:mot-de-passe@hote/base?sslmode=require

# ---------------------------------------------------------------------------
# Stockage des fichiers (photos et PDF)
# ---------------------------------------------------------------------------
# Défini sur Vercel (Vercel Blob) : les envois vont dans le cloud. Laisser vide
# en Docker/local pour écrire sur le disque (dossier media/).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Secret Payload : chaîne aléatoire longue, obligatoire en production.
# En générer une avec : openssl rand -base64 48
PAYLOAD_SECRET=remplacer-par-une-longue-chaine-aleatoire

# ---------------------------------------------------------------------------
# Site public (CORS)
# ---------------------------------------------------------------------------
# Origines autorisées à appeler l'API en lecture, séparées par des virgules.
CBRS_SITE_ORIGINS=https://cbrs-sites.vercel.app,http://127.0.0.1:8092,http://127.0.0.1:8090

# ---------------------------------------------------------------------------
# Docker Compose (docker-compose.prod.yml) — PostgreSQL et port publié
# ---------------------------------------------------------------------------
POSTGRES_DB=cbrs
POSTGRES_USER=cbrs
# Mot de passe de la base PostgreSQL : obligatoire en production.
POSTGRES_PASSWORD=
# Port du CMS publié sur l'hôte (le reverse proxy Nginx/Traefik pointe dessus).
CMS_PORT=3000

# ---------------------------------------------------------------------------
# Envoi des e-mails (« mot de passe oublié »)
# ---------------------------------------------------------------------------
# Laisser SMTP_HOST vide désactive l'envoi : les e-mails sont journalisés
# côté serveur. Renseigner SMTP_HOST active l'adaptateur nodemailer.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@cbrs60.fr

# ---------------------------------------------------------------------------
# Jeu de démonstration (npm run seed)
# ---------------------------------------------------------------------------
# Mot de passe commun des comptes de démonstration, 12 caractères minimum.
CBRS_SEED_PASSWORD=
